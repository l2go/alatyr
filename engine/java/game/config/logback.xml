<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- Keep JUL levels aligned with Logback so a disabled JUL logger is not bridged. -->
	<contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
		<resetJUL>true</resetJUL>
	</contextListener>
	<conversionRule conversionWord="legacyCaller" converterClass="com.l2jfree.util.logging.LegacyCallerConverter"/>
	<conversionRule conversionWord="l2ex" converterClass="com.l2jfree.util.logging.LegacyThrowableConverter"/>
	<!-- Not Logback's console appender: System.out is redirected into the logger, see ProcessStdoutAppender. -->
	<appender name="STDOUT" class="com.l2jfree.util.logging.ProcessStdoutAppender">
		<encoder><pattern>%level [%date{"dd MMM HH:mm:ss,SSS"}] %legacyCaller%msg%l2ex%n</pattern></encoder>
	</appender>
	<appender name="JAVA" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>log/java/java.log</file><append>true</append>
		<encoder><pattern>%level [%date{"dd MMM HH:mm:ss,SSS"}] %legacyCaller%msg%l2ex%n</pattern></encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<fileNamePattern>log/java/java.%i.log</fileNamePattern><minIndex>1</minIndex><maxIndex>50</maxIndex>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy"><maxFileSize>10MB</maxFileSize></triggeringPolicy>
	</appender>
	<appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>log/error/error.log</file><append>true</append>
		<filter class="com.l2jfree.util.logging.ErrorEventFilter"/>
		<encoder><pattern>%level [%date{"dd MMM HH:mm:ss,SSS"}] %legacyCaller%msg%l2ex%n</pattern></encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<fileNamePattern>log/error/error.%i.log</fileNamePattern><minIndex>1</minIndex><maxIndex>50</maxIndex>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy"><maxFileSize>10MB</maxFileSize></triggeringPolicy>
	</appender>
	<appender name="LISTENERS" class="com.l2jfree.util.logging.ListeningLogAppender"/>

	<appender name="AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>log/audit/audit.log</file><append>true</append>
		<encoder><pattern>%date{"dd MMM HH:mm:ss,SSS"} %msg%n</pattern></encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>log/audit/audit.%d{yyyy-MM-dd}.%i.log</fileNamePattern><maxFileSize>10MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>128MB</totalSizeCap>
		</rollingPolicy>
	</appender>
	<appender name="CHAT" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>log/chat/chat.log</file><append>true</append>
		<encoder><pattern>%date{"dd MMM HH:mm:ss,SSS"} %msg%n</pattern></encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>log/chat/chat.%d{yyyy-MM-dd}.%i.log</fileNamePattern><maxFileSize>10MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>128MB</totalSizeCap>
		</rollingPolicy>
	</appender>
	<appender name="ITEM" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>log/item/item.log</file><append>true</append>
		<filter class="com.l2jfree.util.logging.ItemEventFilter"/>
		<encoder><pattern>%date{"dd MMM HH:mm:ss,SSS"} %msg%n</pattern></encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>log/item/item.%d{yyyy-MM-dd}.%i.log</fileNamePattern><maxFileSize>10MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>128MB</totalSizeCap>
		</rollingPolicy>
	</appender>
	<appender name="LOGIN" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>log/login/login.log</file><append>true</append>
		<encoder><pattern>%date{"dd MMM HH:mm:ss,SSS"} %msg%n</pattern></encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>log/login/login.%d{yyyy-MM-dd}.%i.log</fileNamePattern><maxFileSize>10MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>128MB</totalSizeCap>
		</rollingPolicy>
	</appender>
	<appender name="LOGIN_TRY" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>log/login/login.try.log</file><append>true</append>
		<encoder><pattern>%date{"dd MMM HH:mm:ss,SSS"} %msg%n</pattern></encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>log/login/login.try.%d{yyyy-MM-dd}.%i.log</fileNamePattern><maxFileSize>10MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>128MB</totalSizeCap>
		</rollingPolicy>
	</appender>
	<appender name="LOGIN_FAILED" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>log/login/login.failed.log</file><append>true</append>
		<encoder><pattern>%date{"dd MMM HH:mm:ss,SSS"} %msg%n</pattern></encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>log/login/login.failed.%d{yyyy-MM-dd}.%i.log</fileNamePattern><maxFileSize>10MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>128MB</totalSizeCap>
		</rollingPolicy>
	</appender>

	<logger name="audit" level="INFO" additivity="false"><appender-ref ref="AUDIT"/></logger>
	<logger name="chat" level="INFO" additivity="false"><appender-ref ref="CHAT"/></logger>
	<logger name="item" level="INFO" additivity="false"><appender-ref ref="ITEM"/></logger>
	<logger name="login" level="INFO" additivity="false"><appender-ref ref="LOGIN"/></logger>
	<logger name="login.try" level="INFO" additivity="false"><appender-ref ref="LOGIN_TRY"/></logger>
	<logger name="login.failed" level="INFO" additivity="false"><appender-ref ref="LOGIN_FAILED"/></logger>
	<root level="INFO">
		<appender-ref ref="STDOUT"/><appender-ref ref="JAVA"/><appender-ref ref="ERROR"/><appender-ref ref="LISTENERS"/>
	</root>
</configuration>
