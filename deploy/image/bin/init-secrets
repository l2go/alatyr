#!/bin/bash
# Only the database mounts its passwords; the application mounts its DSN alone.
set -euo pipefail
umask 077
dir="${ALATYR_SECRETS_DIR:-/var/lib/alatyr/secrets}"
db_dir="${ALATYR_DB_SECRETS_DIR:-/var/lib/alatyr/secrets-db}"
make_password() {
 local file="$db_dir/$1" temporary
 if [ -s "$file" ]; then
  [[ $(cat "$file") =~ ^[a-f0-9]{64}$ ]] || { echo 'init-secrets: invalid existing password file' >&2; exit 1; }
  return
 fi
 [ ! -L "$file" ] || { echo 'init-secrets: refusing password symlink' >&2; exit 1; }
 temporary="$(mktemp "$db_dir/.password.XXXXXX")"
 od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$temporary"
 chmod 0644 "$temporary"
 mv "$temporary" "$file"
}
make_password postgres_password
make_password world_password
url="$dir/database_url"
expected="postgres://alatyr:$(cat "$db_dir/world_password")@db:5432/alatyr?sslmode=disable"
if [ -s "$url" ]; then
 [ "$(cat "$url")" = "$expected" ] || { echo 'init-secrets: existing DSN does not match database password' >&2; exit 1; }
else
 [ ! -L "$url" ] || { echo 'init-secrets: refusing DSN symlink' >&2; exit 1; }
 temporary="$(mktemp "$dir/.database_url.XXXXXX")"
 printf '%s\n' "$expected" > "$temporary"
 chmod 0600 "$temporary"
 mv "$temporary" "$url"
fi
echo 'init-secrets: credentials ready'
