#!/bin/bash
# The application owns configuration, signal handling, and persistence.
set -euo pipefail
: "${ALATYR_DATABASE_URL_FILE:?ALATYR_DATABASE_URL_FILE is required}"
: "${ALATYR_CONFIG:?ALATYR_CONFIG is required}"
[ -s "$ALATYR_DATABASE_URL_FILE" ] || { echo 'entrypoint: database URL file missing or empty' >&2; exit 1; }
[ -s "$ALATYR_CONFIG" ] || { echo 'entrypoint: participant configuration missing or empty' >&2; exit 1; }
exec /opt/alatyr/bin/alatyr-server -config "$ALATYR_CONFIG" "$@"
