	<groupId>com.l2jfree</groupId>
	<artifactId>l2jfree-ct2.3-root</artifactId>
	<version>3.2.1</version>
	<packaging>pom</packaging>
	<name>l2jfree-ct2.3 (repository root aggregator)</name>
	<modules>
		<module>engine/java</module>
	</modules>
</project>
